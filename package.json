{
  "name": "local-keepflash",
  "description": "A local-first web clipper that saves pages, selections, images, and YouTube transcripts directly as Markdown.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wxt -p 3002",
    "prebuild": "npm run licenses",
    "build": "wxt build",
    "prezip": "npm run licenses",
    "zip": "wxt zip",
    "prepare": "npm run licenses && wxt prepare",
    "licenses": "node scripts/generate-third-party-licenses.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:build": "node scripts/audit-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "idb-keyval": "^6.2.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/jsdom": "^27.0.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.11.0",
    "jsdom": "^27.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
